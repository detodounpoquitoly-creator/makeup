# Copiá este archivo como .env.local (local) o cargá estas variables en Vercel.
# Las dos de Supabase son las únicas OBLIGATORIAS (Pasos 1 y 2 del LEEME.md).

# ── Supabase (obligatorio) ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=TU-CLAVE-DE-SERVICIO

# ── Contraseña del panel de administración (podés cambiarla) ──────────
ADMIN_PASSWORD=maquillaje2026

# ── Mercado Pago (opcional: sin esto, el pago es por transferencia) ────
MP_ACCESS_TOKEN=

# ── Emails (opcional: sin Resend, los avisos quedan en el panel "Avisos") ──
RESEND_API_KEY=
RESEND_FROM=

# ── Origen (para volver de Mercado Pago tras pagar; en Vercel va el dominio) ──
ORIGEN=
